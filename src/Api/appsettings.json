{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.HealthChecks.HealthCheckService": "Information",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "unicode": false
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:9500"
      }
    }
  },
  "ZontSettings": {
    "Email": "",
    "Login": "",
    "Password": "",
    "ApiUrl": "https://my.zont.online/api/widget/v3/",
    "CollectDeviceDataInterval": "00:05:00"
  },
  "HealthCheckSettings": {
    "Interval": "00:05:00",
    "IsEnabled": true,
    "Delay": "00:00:01",
    "Period": "00:00:01"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=???;Port=???;Database=CottageSensorAggregator;Username=???;Password=???"
  }
}
